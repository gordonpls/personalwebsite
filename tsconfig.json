{
    "compilerOptions": {
        "jsx": "react-jsx",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "types": ["node", "vite/client"],
        "moduleResolution": "bundler",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noImplicitAny": false,
    }
}