# LiteSpeed's server-level cache ignores the origin Cache-Control below and was
# serving a stale index.html (old hashed bundles) after deploys. Disable its
# public page cache for this site so freshly deployed HTML is always served.
<IfModule LiteSpeed>
CacheDisable public /
</IfModule>

Options -MultiViews
RewriteEngine On

# Anchor aliases: top-level paths that should jump to a section on the home page.
RewriteRule ^about/?$    /#about    [R=302,L]
RewriteRule ^resume/?$   /#resume   [R=302,L]
RewriteRule ^projects/?$ /#projects [R=302,L]
RewriteRule ^highlights/?$ /#highlights [R=302,L]
RewriteRule ^gallery/?$  /#gallery  [R=302,L]

# /stablecoin → the live dashboard (kept reachable via gordonzhong.com/stablecoin)
RewriteRule ^stablecoin/?$ https://stablecoin-dashboard-gz.streamlit.app/ [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ index.html [QSA,L]

# Cache policy: always revalidate the app shell so a new deploy is never masked
# by a stale cached index.html (which would keep loading old hashed bundles).
# The hashed JS/CSS/font/image assets are immutable and cached aggressively.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|mp4|webm|mov|webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
