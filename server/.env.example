# ── Plaid ────────────────────────────────────────────────────────────────────
PLAID_ENV=production
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
# Legacy single-token fallback (superseded by .plaid-items.json)
PLAID_ACCESS_TOKEN=

# Set to "true" locally to access the /api/link/* and /api/items/* setup endpoints.
# Never set in production — these endpoints must stay 404 in prod.
PLAID_SETUP_ENABLED=false

# Gates /api/plaid/relink — pick any secret string, set the same value in prod.
PLAID_RELINK_SECRET=

# ── Spotify ───────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Seed refresh token. Runtime rotations are auto-persisted to server/data/spotify-tokens.json
# which takes priority on subsequent restarts — keep this updated when tokens rotate.
SPOTIFY_REFRESH_TOKEN=

# Gates /api/spotify/reauth — pick any secret string, set the same value in prod.
SPOTIFY_REAUTH_SECRET=

# Must match a Redirect URI registered in your Spotify app dashboard.
# Prod:  https://gordonzhong.com/api/spotify/callback
# Local: http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# ── Email notifications ───────────────────────────────────────────────────────
# Recipient for server alerts (e.g. Plaid relink needed). Uses server sendmail — no password required.
NOTIFY_TO=
# Sender shown in the From header (default: noreply@gordonzhong.com)
NOTIFY_FROM=noreply@gordonzhong.com
# Base URL used in alert email action links (default: https://gordonzhong.com)
SITE_URL=https://gordonzhong.com

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Finnhub ───────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
